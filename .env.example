# ==============================================================================
# COMPANY INTELLIGENCE AGENT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED PRODUCTION ENVIRONMENT VARIABLES (CONFIGURE IN RAILWAY DASHBOARD)
# ------------------------------------------------------------------------------

# Database connection string (Automatically provided by Railway PostgreSQL plugin)
# Supports postgresql://, postgres://, or postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:password@host:port/database

# Secure API Key for protecting REST endpoints (POST /run, GET /companies, etc.)
# Provide a strong random secret token
API_KEY=your-secure-production-api-key-here

# Google Sheets Ingestion & Synchronization
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheets-spreadsheet-id

# Google Service Account Credentials:
# For Railway / Containerized Deployment (Recommended):
# Paste the full raw JSON content of your Google Cloud service account key
GOOGLE_SERVICE_ACCOUNT_INFO='{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}'

# LLM Provider Configuration
# Choose: "gemini", "groq", "openai", or "fake" (for mock/offline testing)
LLM_PROVIDER=gemini

# Primary LLM API Key (Set the key corresponding to chosen LLM_PROVIDER)
GEMINI_API_KEY=your-gemini-api-key-here
# GROQ_API_KEY=your-groq-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here


# ------------------------------------------------------------------------------
# 2. OPTIONAL APPLICATION & PERFORMANCE TUNING (DEFAULTS ARE PRODUCTION-READY)
# ------------------------------------------------------------------------------

# Application Environment & Server Settings
APP_ENV=production
APP_NAME="Company Intelligence Agent"
LOG_LEVEL=INFO
# Dynamic port assigned by Railway (defaults to 8000 locally)
PORT=8000
HOST_PORT=8200

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false

# Google Sheets Worksheet & Header Mapping
GOOGLE_SHEETS_WORKSHEET_NAME=Companies
GOOGLE_SHEETS_COMPANY_NAME_COL="Company Name"
GOOGLE_SHEETS_WEBSITE_COL="Website"
GOOGLE_SHEETS_STATUS_COL="Status"

# Google Sheets Output Sync Columns
GOOGLE_SHEETS_FIT_COL="Fit"
GOOGLE_SHEETS_CONFIDENCE_COL="Confidence"
GOOGLE_SHEETS_REASONING_COL="Reasoning"
GOOGLE_SHEETS_FOLLOW_UP_COL="Follow-up Question"
GOOGLE_SHEETS_LAST_SYNCED_COL="Last Synced"
SYNC_MAX_RETRIES=3
SYNC_RETRY_BACKOFF_SECONDS=1.0

# LLM Execution & Evaluation Bounds
LLM_MODEL=gemini-3.6-flash
RUBRIC_PATH=config/rubric.yaml
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2

# Pipeline Concurrency & Enrichment Engine Bounds
PIPELINE_MAX_CONCURRENCY=3
PIPELINE_LEASE_DURATION_MINUTES=5
PIPELINE_ENABLE_BROWSER=true
PIPELINE_BROWSER_TIMEOUT_SECONDS=30.0

# In-Process Periodic Scheduler (Single-Replica Deployments Only)
# Disabled by default in production. Set to true if running a single replica.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=360
